<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may reach the local backend over HTTP, wherever it is: 10.0.2.2 from the emulator, or
     the IP of the computer from a phone on the same Wi-Fi. This file cannot name a whole network, and
     that IP is different on each computer, so it allows any host. Release builds only talk HTTPS. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
