<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- On Android 17 an app needs it to reach an address on its own network: the IP of the computer from
         a phone on the same Wi-Fi, or 10.0.2.2 from the emulator. Without it the connections just time out.
         Release builds talk to a public server. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
</manifest>
