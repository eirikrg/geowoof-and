# Copy to secrets.properties (git-ignored).
# Everything is optional: uncomment only the values you have. A key left empty breaks the
# generated BuildConfig, and a key that is missing takes its value from local.defaults.properties.

# Google Maps SDK for Android (needed to see map tiles; the app works without it).
# MAPS_API_KEY=your_maps_key

# Web OAuth client ID for Sign in with Google (without it, the Google button is hidden).
# GOOGLE_SERVER_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Backend URL. Default: the host machine as seen from the emulator (http://10.0.2.2:8080/).
# On a physical device on the same network: the IP of this computer.
# API_BASE_URL=http://192.168.1.50:8080/
