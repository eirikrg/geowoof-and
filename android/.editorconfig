# Android (Kotlin) conventions. Inherits the repository root .editorconfig; read by ktlint via Spotless.

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = android_studio
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
# Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Design-system CompositionLocals allowed by the Compose rules.
compose_allowed_composition_locals = LocalSpacing

[*.xml]
indent_size = 4
